{
  "expo": {
    "name": "Frog Labs",
    "slug": "frogs-cardano-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.frogs.cardanoapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8F00"
      }
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FrogsPool",
              "label": "Frog Labs Pool",
              "description": "LEAP pool: epoch, blocks, delegators, stake",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FrogsPoolMini",
              "label": "Frog Labs Pool Mini",
              "description": "Pool logo, blocks this epoch, live stake, delegators, saturation",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FrogsAda",
              "label": "Frog Labs ADA",
              "description": "ADA price and 24h change",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FrogsNight",
              "label": "Frog Labs NIGHT",
              "description": "Midnight (NIGHT) price and 24h change",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FrogsBtc",
              "label": "Frog Labs BTC",
              "description": "Bitcoin price and 24h change",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4ADE80"
        }
      ],
      "expo-background-task"
    ],
    "icon": "./assets/icon.png"
  }
}