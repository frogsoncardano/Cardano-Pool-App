{
  "expo": {
    "name": "Frog Labs",
    "slug": "frogs-cardano-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "com.frogs.cardanoapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8F00"
      }
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FrogsPool",
              "label": "Frog Labs Pool",
              "description": "LEAP pool: epoch, blocks, delegators, stake",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FrogsBlocks",
              "label": "Frog Labs Blocks",
              "description": "Blocks produced this epoch + total",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}